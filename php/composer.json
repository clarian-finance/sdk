{
  "name": "clarian-finance/sdk-php",
  "description": "Official PHP SDK for the Clarian Finance API v2",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "classmap": ["src/"]
  },
  "autoload-dev": {
    "classmap": ["tests/"]
  },
  "scripts": {
    "test": "phpunit",
    "e2e": "php e2e/sandbox.php"
  }
}
